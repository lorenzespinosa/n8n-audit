{
  "name": "Status page heartbeat",
  "active": true,
  "nodes": [
    {
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [0, 200],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } }
    },
    {
      "name": "Ping status page",
      "type": "n8n-nodes-base.httpRequest",
      "position": [220, 200],
      "parameters": { "url": "https://status.example.com/heartbeat", "options": {} },
      "onError": "continueErrorOutput"
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Ping status page", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "errorWorkflow": "wf_ops" },
  "tags": ["clean", "fixture"]
}
